<p>
  <script>
    // ============================================================
    // FUNCIÓN PRINCIPAL DE CÁLCULO
    // ============================================================
    function calcularTodo() {
      try {
        // Leer valores Eλ
        var e_265 = parseFloat(document.getElementById('e_265').value) || 0;
        var e_270 = parseFloat(document.getElementById('e_270').value) || 0;
        var e_275 = parseFloat(document.getElementById('e_275').value) || 0;
        var e_280 = parseFloat(document.getElementById('e_280').value) || 0;

        // Leer valores Sλ
        var s_265 = parseFloat(document.getElementById('s_265').value) || 0;
        var s_270 = parseFloat(document.getElementById('s_270').value) || 0;
        var s_275 = parseFloat(document.getElementById('s_275').value) || 0;
        var s_280 = parseFloat(document.getElementById('s_280').value) || 0;

        // Leer valores Δλ
        var d_265 = parseFloat(document.getElementById('d_265').value) || 0;
        var d_270 = parseFloat(document.getElementById('d_270').value) || 0;
        var d_275 = parseFloat(document.getElementById('d_275').value) || 0;
        var d_280 = parseFloat(document.getElementById('d_280').value) || 0;

        // --- CÁLCULOS ---
        var prod_265 = e_265 * s_265 * d_265;
        var prod_270 = e_270 * s_270 * d_270;
        var prod_275 = e_275 * s_275 * d_275;
        var prod_280 = e_280 * s_280 * d_280;
        var totalEff = prod_265 + prod_270 + prod_275 + prod_280;

        // Actualizar celdas de productos
        document.getElementById('prod_265').innerHTML = prod_265.toFixed(2);
        document.getElementById('prod_270').innerHTML = prod_270.toFixed(2);
        document.getElementById('prod_275').innerHTML = prod_275.toFixed(2);
        document.getElementById('prod_280').innerHTML = prod_280.toFixed(2);
        document.getElementById('totalEff').innerHTML = totalEff.toFixed(2);
        document.getElementById('resultEff').innerHTML = totalEff.toFixed(2);

        // --- SECCIÓN DE RIESGO ---
        var tiempo = parseFloat(document.getElementById('tiempo').value) || 0;
        var heff = totalEff * tiempo;
        var VLE = 30;
        var ir = heff / VLE;

        document.getElementById('heff').innerHTML = heff.toFixed(2);
        document.getElementById('ir').innerHTML = ir.toFixed(2);

        // Actualizar indicador visual
        var indicador = document.getElementById('indicador');
        var posicion = Math.min(ir, 2.0) / 2.0 * 100;
        indicador.style.left = Math.min(posicion, 96) + '%';

        // Cambiar estado según riesgo
        var estado = document.getElementById('estado');
        var mensaje = document.getElementById('mensaje');

        if (ir > 1.0) {
          estado.style.background = '#fce1e1';
          estado.style.color = '#a12727';
          estado.style.border = '1px solid #dba6a6';
          estado.innerHTML = '⚠️ SUPERA VLE-1';
          mensaje.innerHTML =
            '🔴 <strong>"Supera el VLE-1"</strong> · Riesgo alto. ¡Se deben tomar medidas de control inmediatas!';
        } else {
          estado.style.background = '#dff0d8';
          estado.style.color = '#1f6b3b';
          estado.style.border = '1px solid #b3d6b3';
          estado.innerHTML = '✅ Cumple VLE-1';
          mensaje.innerHTML = '🟢 Condición segura · IR ≤ 1.0';
        }

        return true;
      } catch (e) {
        return false;
      }
    }

    // ============================================================
    // FUNCIONES DE CONTROL
    // ============================================================
    function resetearTodo() {
      document.getElementById('e_265').value = '0';
      document.getElementById('e_270').value = '0';
      document.getElementById('e_275').value = '0';
      document.getElementById('e_280').value = '0';
      document.getElementById('s_265').value = '0';
      document.getElementById('s_270').value = '0';
      document.getElementById('s_275').value = '0';
      document.getElementById('s_280').value = '0';
      document.getElementById('d_265').value = '5';
      document.getElementById('d_270').value = '5';
      document.getElementById('d_275').value = '5';
      document.getElementById('d_280').value = '5';
      document.getElementById('tiempo').value = '1.0';
      calcularTodo();
    }

    function cargarEjemplo() {
      document.getElementById('e_265').value = '0.5';
      document.getElementById('e_270').value = '0.8';
      document.getElementById('e_275').value = '1.2';
      document.getElementById('e_280').value = '0.6';
      document.getElementById('s_265').value = '0.50';
      document.getElementById('s_270').value = '0.85';
      document.getElementById('s_275').value = '0.95';
      document.getElementById('s_280').value = '0.88';
      document.getElementById('d_265').value = '5';
      document.getElementById('d_270').value = '5';
      document.getElementById('d_275').value = '5';
      document.getElementById('d_280').value = '5';
      document.getElementById('tiempo').value = '1.0';
      calcularTodo();
    }

    function cargarEjemploRiesgo() {
      document.getElementById('e_265').value = '3.0';
      document.getElementById('e_270').value = '4.0';
      document.getElementById('e_275').value = '5.0';
      document.getElementById('e_280').value = '3.0';
      document.getElementById('s_265').value = '0.50';
      document.getElementById('s_270').value = '0.85';
      document.getElementById('s_275').value = '0.95';
      document.getElementById('s_280').value = '0.88';
      document.getElementById('d_265').value = '5';
      document.getElementById('d_270').value = '5';
      document.getElementById('d_275').value = '5';
      document.getElementById('d_280').value = '5';
      document.getElementById('tiempo').value = '2.0';
      calcularTodo();
    }

    // ============================================================
    // TEMPORIZADOR (ACTUALIZACIÓN AUTOMÁTICA)
    // ============================================================
    var valoresAnteriores = {};

    function verificarCambios() {
      try {
        var campos = [
          'e_265', 'e_270', 'e_275', 'e_280',
          's_265', 's_270', 's_275', 's_280',
          'd_265', 'd_270', 'd_275', 'd_280',
          'tiempo'
        ];
        var hayCambios = false;

        for (var i = 0; i < campos.length; i++) {
          var id = campos[i];
          var elemento = document.getElementById(id);
          if (elemento) {
            var valorActual = elemento.value;
            if (valoresAnteriores[id] !== valorActual) {
              valoresAnteriores[id] = valorActual;
              hayCambios = true;
            }
          }
        }

        if (hayCambios) {
          calcularTodo();
        }
      } catch (e) {
        // Silencioso
      }
    }

    // Iniciar temporizador
    setInterval(verificarCambios, 500);

    // Calcular al cargar
    calcularTodo();

    console.log(
      '✅ Simulador de Irradiancia Efectiva + Índice de Riesgo funcionando');
  </script>

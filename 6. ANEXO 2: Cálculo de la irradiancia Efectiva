      document.getElementById('e2_265').value = '0.5';
      document.getElementById('e2_270').value = '0.8';
      document.getElementById('e2_275').value = '1.2';
      document.getElementById('e2_280').value = '0.6';
      document.getElementById('s2_265').value = '0.50';
      document.getElementById('s2_270').value = '0.85';
      document.getElementById('s2_275').value = '0.95';
      document.getElementById('s2_280').value = '0.88';
      document.getElementById('d2_265').value = '5';
      document.getElementById('d2_270').value = '5';
      document.getElementById('d2_275').value = '5';
      document.getElementById('d2_280').value = '5';

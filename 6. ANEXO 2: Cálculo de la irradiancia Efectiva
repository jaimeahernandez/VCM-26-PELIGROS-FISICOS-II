<p>
  <script>
    // ============================================================
    // FUNCIÓN PRINCIPAL DE CÁLCULO
    // ============================================================
    function calcularTodo() {
      try {
        // Leer valores Eλ
        var e2_265 = parseFloat(document.getElementById('e2_265').value) || 0;
        var e2_270 = parseFloat(document.getElementById('e2_270').value) || 0;
        var e2_275 = parseFloat(document.getElementById('e2_275').value) || 0;
        var e2_280 = parseFloat(document.getElementById('e2_280').value) || 0;

        // Leer valores Sλ (editables por el estudiante)
        var s2_265 = parseFloat(document.getElementById('s2_265').value) || 0;
        var s2_270 = parseFloat(document.getElementById('s2_270').value) || 0;
        var s2_275 = parseFloat(document.getElementById('s2_275').value) || 0;
        var s2_280 = parseFloat(document.getElementById('s2_280').value) || 0;

        // Leer valores Δλ (editables)
        var d2_265 = parseFloat(document.getElementById('d2_265').value) || 0;
        var d2_270 = parseFloat(document.getElementById('d2_270').value) || 0;
        var d2_275 = parseFloat(document.getElementById('d2_275').value) || 0;
        var d2_280 = parseFloat(document.getElementById('d2_280').value) || 0;

        // --- CÁLCULOS ---
        var prod2_265 = e2_265 * s2_265 * d2_265;
        var prod2_270 = e2_270 * s2_270 * d2_270;
        var prod2_275 = e2_275 * s2_275 * d2_275;
        var prod2_280 = e2_280 * s2_280 * d2_280;
        var totalEff = prod2_265 + prod2_270 + prod2_275 + prod2_280;

        // Actualizar celdas con 2 decimales
        document.getElementById('prod2_265').innerHTML = prod2_265.toFixed(2);
        document.getElementById('prod2_270').innerHTML = prod2_270.toFixed(2);
        document.getElementById('prod2_275').innerHTML = prod2_275.toFixed(2);
        document.getElementById('prod2_280').innerHTML = prod2_280.toFixed(2);
        document.getElementById('totalEff').innerHTML = totalEff.toFixed(2);
        document.getElementById('resultEff').innerHTML = totalEff.toFixed(2);

        return true;
      } catch (e) {
        return false;
      }
    }

    // ============================================================
    // FUNCIONES DE CONTROL
    // ============================================================
    function resetearTodo() {
      document.getElementById('e2_265').value = '0';
      document.getElementById('e2_270').value = '0';
      document.getElementById('e2_275').value = '0';
      document.getElementById('e2_280').value = '0';
      document.getElementById('s2_265').value = '0';
      document.getElementById('s2_270').value = '0';
      document.getElementById('s2_275').value = '0';
      document.getElementById('s2_280').value = '0';
      document.getElementById('d2_265').value = '5';
      document.getElementById('d2_270').value = '5';
      document.getElementById('d2_275').value = '5';
      document.getElementById('d2_280').value = '5';
      calcularTodo();
    }

    function cargarEjemplo() {

    function cargarEjemploPersonalizado() {
      // Valores personalizados (ejemplo con Sλ diferentes)
      document.getElementById('e2_265').value = '0.5';
      document.getElementById('e2_270').value = '0.8';
      document.getElementById('e2_275').value = '1.2';
      document.getElementById('e2_280').value = '0.6';
      document.getElementById('s2_265').value = '0.30';
      document.getElementById('s2_270').value = '0.75';
      document.getElementById('s2_275').value = '1.00';
      document.getElementById('s2_280').value = '0.60';
      document.getElementById('d2_265').value = '4';
      document.getElementById('d2_270').value = '6';
      document.getElementById('d2_275').value = '5';
      document.getElementById('d2_280').value = '7';
      calcularTodo();
    }

    // ============================================================
    // TEMPORIZADOR (ACTUALIZACIÓN AUTOMÁTICA)
    // ============================================================
    var valoresAnteriores = {};

    function verificarCambios() {
      try {
        var campos = [
          'e2_265', 'e2_270', 'e2_275', 'e2_280',
          's2_265', 's2_270', 's2_275', 's2_280',
          'd2_265', 'd2_270', 'd2_275', 'd2_280'
        ];
        var hayCambios = false;

        for (var i = 0; i < campos.length; i++) {
          var id = campos[i];
          var elemento = document.getElementById(id);
          if (elemento) {
            var valorActual = elemento.value;
            if (valoresAnteriores[id] !== valorActual) {
              valoresAnteriores[id] = valorActual;
              hayCambios = true;
            }
          }
        }

        if (hayCambios) {
          calcularTodo();
        }
      } catch (e) {
        // Silencioso
      }
    }

    // Iniciar temporizador
    setInterval(verificarCambios, 500);

    // Calcular al cargar
    calcularTodo();

    console.log('✅ Simulador de Irradiancia Efectiva funcionando');

<p>
  <script>
    // ============================================================
    // FUNCIÓN PRINCIPAL DE CÁLCULO
    // ============================================================
    function calcularTodo() {
      try {
        // Leer valores Eλ
        var e1_265 = parseFloat(document.getElementById('e1_265').value) || 0;
        var e1_270 = parseFloat(document.getElementById('e1_270').value) || 0;
        var e1_275 = parseFloat(document.getElementById('e1_275').value) || 0;
        var e1_280 = parseFloat(document.getElementById('e1_280').value) || 0;

        // Leer valores Δλ (editable)
        var d1_265 = parseFloat(document.getElementById('d1_265').value) || 0;
        var d1_270 = parseFloat(document.getElementById('d1_270').value) || 0;
        var d1_275 = parseFloat(document.getElementById('d1_275').value) || 0;
        var d1_280 = parseFloat(document.getElementById('d1_280').value) || 0;

        // --- CÁLCULOS ---
        var prod1_265 = e1_265 * d1_265;
        var prod1_270 = e1_270 * d1_270;
        var prod1_275 = e1_275 * d1_275;
        var prod1_280 = e1_280 * d1_280;
        var totalE = prod1_265 + prod1_270 + prod1_275 + prod1_280;

        // Actualizar celdas con 2 decimales
        document.getElementById('prod1_265').innerHTML = prod1_265.toFixed(2);
        document.getElementById('prod1_270').innerHTML = prod1_270.toFixed(2);
        document.getElementById('prod1_275').innerHTML = prod1_275.toFixed(2);
        document.getElementById('prod1_280').innerHTML = prod1_280.toFixed(2);
        document.getElementById('totalE').innerHTML = totalE.toFixed(2);
        document.getElementById('resultE').innerHTML = totalE.toFixed(2);

        return true;
      } catch (e) {
        return false;
      }
    }

    // ============================================================
    // FUNCIONES DE CONTROL
    // ============================================================
    function resetearTodo() {
      document.getElementById('e1_265').value = '0';
      document.getElementById('e1_270').value = '0';
      document.getElementById('e1_275').value = '0';
      document.getElementById('e1_280').value = '0';
      document.getElementById('d1_265').value = '5';
      document.getElementById('d1_270').value = '5';
      document.getElementById('d1_275').value = '5';
      document.getElementById('d1_280').value = '5';
      calcularTodo();
    }

    function cargarEjemplo() {
      document.getElementById('e1_265').value = '0.5';
      document.getElementById('e1_270').value = '0.8';
      document.getElementById('e1_275').value = '1.2';
      document.getElementById('e1_280').value = '0.6';
      document.getElementById('d1_265').value = '5';
      document.getElementById('d1_270').value = '5';
      document.getElementById('d1_275').value = '5';
      document.getElementById('d1_280').value = '5';
      calcularTodo();
    }

    function cargarEjemploDeltaVariable() {
      document.getElementById('e1_265').value = '0.5';
      document.getElementById('e1_270').value = '0.8';
      document.getElementById('e1_275').value = '1.2';
      document.getElementById('e1_280').value = '0.6';
      document.getElementById('d1_265').value = '4';
      document.getElementById('d1_270').value = '6';
      document.getElementById('d1_275').value = '5';
      document.getElementById('d1_280').value = '7';
      calcularTodo();
    }

    // ============================================================
    // TEMPORIZADOR (ACTUALIZACIÓN AUTOMÁTICA)
    // ============================================================
    var valoresAnteriores = {};

    function verificarCambios() {
      try {
        var campos = ['e1_265', 'e1_270', 'e1_275', 'e1_280', 'd1_265',
          'd1_270', 'd1_275', 'd1_280'
        ];
        var hayCambios = false;

        for (var i = 0; i < campos.length; i++) {
          var id = campos[i];
          var elemento = document.getElementById(id);
          if (elemento) {
            var valorActual = elemento.value;
            if (valoresAnteriores[id] !== valorActual) {
              valoresAnteriores[id] = valorActual;
              hayCambios = true;
            }
          }
        }

        if (hayCambios) {
          calcularTodo();
        }
      } catch (e) {
        // Silencioso
      }
    }

    // Iniciar temporizador
    setInterval(verificarCambios, 500);

    // Calcular al cargar
    calcularTodo();

    console.log('✅ Simulador de Irradiancia Total funcionando');
  </script>

          select.appendChild(opt);
        }
      }

      function cambiarActividad(valor) {
        actividadActual = valor;

        var btn90 = document.getElementById('btn90');
        var btn110 = document.getElementById('btn110');
        var label = document.getElementById('actividadLabel');
        var tablaLabel = document.getElementById('tablaActividadLabel');

        if (valor === 90) {
          btn90.style.background = '#2e86c1';
          btn90.style.color = 'white';
          btn90.style.borderColor = '#2e86c1';
          btn110.style.background = 'white';
          btn110.style.color = '#0a2a44';
          btn110.style.borderColor = '#d0dbe8';
          label.textContent = '🔵 90 Kcal/h';
          tablaLabel.textContent = '90 Kcal/h';
        } else {
          btn110.style.background = '#2e86c1';
          btn110.style.color = 'white';
          btn110.style.borderColor = '#2e86c1';
          btn90.style.background = 'white';
          btn90.style.color = '#0a2a44';
          btn90.style.borderColor = '#d0dbe8';
          label.textContent = '🟢 110 Kcal/h';
          tablaLabel.textContent = '110 Kcal/h';
        }

        cargarTemperaturas();
        actualizarDisplay();
      }

      function renderizarTabla(cloSeleccionado, tempSeleccionado,
        velSeleccionado) {
        var thead = document.getElementById('tablaHead');
        var tbody = document.getElementById('tablaBody');
        var temps = getTempsActividad();
        var datos = getDatosActividad();

        // HEADER
        var headerHTML =
          '<tr><th style="padding:8px 6px; background:#0a2a44; color:white; position:sticky; left:0; z-index:2; min-width:80px;">Temp. ↓</th>';
        for (var i = 0; i < velLabels.length; i++) {
          var isSelected = (i === velValues.indexOf(velSeleccionado)) ?
            'background:#e74c3c;' : '';
          headerHTML +=
            '<th style="padding:8px 4px; background:#0a2a44; color:white; text-align:center; font-size:0.7rem; min-width:45px; ' +
            isSelected + '">' + velLabels[i] + '</th>';
        }
        headerHTML += '</tr>';
        thead.innerHTML = headerHTML;

        // BODY
        var bodyHTML = '';
        for (var t = 0; t < temps.length; t++) {
          var temp = temps[t];
          bodyHTML += '<tr>';
          var estiloTemp =
            'padding:6px 4px; border:1px solid #dbe3ef; text-align:center; font-weight:600; background:#eef4fc;';
          if (temp === tempSeleccionado) {
            estiloTemp += ' background:#ffeb3b;';
          }
          bodyHTML += '<td style="' + estiloTemp + '">' + temp + '</td>';

          for (var v = 0; v < velValues.length; v++) {
            var vel = velValues[v];
            var valor = getPMV(cloSeleccionado, temp, vel);
            var estado = getEstadoPMV(valor);

            var estilo =
              'padding:6px 4px; border:1px solid #dbe3ef; text-align:center; font-weight:500;';

            if (valor !== null && valor !== undefined) {
              if (estado.clase === 'confort') estilo +=
                ' background:#d4edda; color:#155724;';
              else if (estado.clase === 'alerta') estilo +=
                ' background:#fff3cd; color:#856404;';
              else if (estado.clase === 'peligro') estilo +=
                ' background:#f8d7da; color:#721c24;';
            } else {
              estilo += ' background:#f0f0f0; color:#999;';
            }

            if (temp === tempSeleccionado && Math.abs(vel -
                velSeleccionado) < 0.001) {
              estilo +=
                ' outline:3px solid #c0392b; font-weight:800; background:#ff6b6b !important; color:white !important;';
            }

            var displayVal = (valor !== null && valor !== undefined) ? valor
              .toFixed(2) : '—';
            bodyHTML += '<td style="' + estilo + '">' + displayVal +
              '</td>';
          }
          bodyHTML += '</tr>';
        }
        tbody.innerHTML = bodyHTML;
      }

      function actualizarDisplay() {
        var clo = parseFloat(document.getElementById('cloFilter').value);
        var temp = parseFloat(document.getElementById('tempFilter').value);
        var vel = parseFloat(document.getElementById('velFilter').value);

        var valor = getPMV(clo, temp, vel);
        var estado = getEstadoPMV(valor);

        document.getElementById('pmvDisplay').textContent = (valor !==
          null && valor !== undefined) ? valor.toFixed(2) : '—';
        var estadoDiv = document.getElementById('pmvEstado');
        estadoDiv.textContent = estado.texto;
        estadoDiv.style.background = estado.color;
        estadoDiv.style.color = (estado.clase === 'alerta') ? '#0a2a44' :
          'white';

        renderizarTabla(clo, temp, vel);
      }

      // ============================================================
      // 5. EVENT LISTENERS
      // ============================================================
      document.getElementById('btn90').addEventListener('click',
        function() {
          cambiarActividad(90);
        });
      document.getElementById('btn110').addEventListener('click',
        function() {
          cambiarActividad(110);
        });
      document.getElementById('cloFilter').addEventListener('change',
        actualizarDisplay);
      document.getElementById('tempFilter').addEventListener('change',
        actualizarDisplay);
      document.getElementById('velFilter').addEventListener('change',
        actualizarDisplay);

      // ============================================================
      // 6. INICIALIZAR
      // ============================================================
      cargarTemperaturas();
      actualizarDisplay();
    });
  </script>
</p>

<p>
  <script>
    (function() {
      const limitesPermisibles = [
        [31.0, 28.0, null, null],
        [31.0, 29.0, 27.5, null],
        [32.0, 30.0, 29.0, 28.0],
        [32.5, 31.5, 30.5, 30.0]
      ];

      function clasificarMetabolismo(kcalH) {
        if (kcalH < 200) return {
          cat: 'Liviano (< 200 kcal/h)',
          idx: 0
        };
        if (kcalH <= 300) return {
          cat: 'Moderado (200–300 kcal/h)',
          idx: 1
        };
        if (kcalH <= 400) return {
          cat: 'Pesado (300–400 kcal/h)',
          idx: 2
        };
        return {
          cat: 'Muy Pesado (> 400 kcal/h)',
          idx: 3
        };
      }

      function crearFila(nombre, th, tg, ts, t) {
        const tr = document.createElement('tr');
        tr.innerHTML = `
        <td style="padding: 6px; border: 1px solid #e2e8f0;">
          <input type="text" class="tarea-nombre" value="${nombre}"
            style="width: 100%; box-sizing: border-box; padding: 6px 8px; border: 1px solid #cbd5e1; border-radius: 6px;">
        </td>
        <td style="padding: 6px; border: 1px solid #e2e8f0;">
          <input type="number" step="0.1" class="tarea-th" value="${th}"
            style="width: 100%; box-sizing: border-box; padding: 6px; border: 1px solid #cbd5e1; border-radius: 6px; text-align: center;">
        </td>
        <td style="padding: 6px; border: 1px solid #e2e8f0;">
          <input type="number" step="0.1" class="tarea-tg" value="${tg}"
            style="width: 100%; box-sizing: border-box; padding: 6px; border: 1px solid #cbd5e1; border-radius: 6px; text-align: center;">
        </td>
        <td style="padding: 6px; border: 1px solid #e2e8f0;">
          <input type="number" step="0.1" class="tarea-ts" value="${ts}"
            style="width: 100%; box-sizing: border-box; padding: 6px; border: 1px solid #cbd5e1; border-radius: 6px; text-align: center;">
        </td>
        <td style="padding: 6px; border: 1px solid #e2e8f0;">
          <input type="number" step="0.1" class="tarea-t" value="${t}"
            style="width: 100%; box-sizing: border-box; padding: 6px; border: 1px solid #cbd5e1; border-radius: 6px; text-align: center;">
        </td>
        <td class="tarea-wbgt" style="padding: 6px 8px; border: 1px solid #e2e8f0; text-align: center; font-weight: 700; color: #07192f;">
          0.00
        </td>
        <td class="tarea-pond" style="padding: 6px 8px; border: 1px solid #e2e8f0; text-align: right; font-weight: 600; color: #334155;">
          0.00
        </td>
        <td style="padding: 6px; border: 1px solid #e2e8f0; text-align: center;">
          <button type="button" class="btn-quitar-fila"
            style="background: #fee2e2; color: #991b1b; border: 1px solid #fca5a5; padding: 5px 9px; border-radius: 6px; cursor: pointer; font-weight: bold;">✕</button>
        </td>
      `;
        return tr;
      }

      function vincularBotonesEliminar() {
        const botones = document.querySelectorAll(
          '#cuerpoTareasCalc .btn-quitar-fila');
        botones.forEach((btn) => {
          btn.onclick = function() {
            const tbody = document.getElementById('cuerpoTareasCalc');
            if (tbody && tbody.rows.length > 1) {
              btn.closest('tr').remove();
              calcularTodo();
            }
          };
        });
      }

      function agregarFilaTarea() {
        const tbody = document.getElementById('cuerpoTareasCalc');
        if (!tbody) return;
        const n = tbody.rows.length + 1;
        tbody.appendChild(crearFila(`Actividad ${n}`, 25.0, 34.0, 32.0, 2.0));
        vincularBotonesEliminar();
        calcularTodo();
      }

      function calcularTodo() {
        const tbody = document.getElementById('cuerpoTareasCalc');
        if (!tbody) return;

        const metVal = parseFloat(document.getElementById('metPromInput')
          .value) || 0;
        const cafVal = parseFloat(document.getElementById('cafVestimenta')
          .value) || 0;
        const cicloIdx = parseInt(document.getElementById('cicloCalc').value,
          10) || 0;

        const filas = Array.from(tbody.querySelectorAll('tr'));
        let sumaPond = 0;
        let sumaTiempo = 0;

        filas.forEach((tr) => {
          const th = parseFloat(tr.querySelector('.tarea-th').value) || 0;
          const tg = parseFloat(tr.querySelector('.tarea-tg').value) || 0;
          const t = parseFloat(tr.querySelector('.tarea-t').value) || 0;

          const wbgtAct = (0.7 * th) + (0.3 * tg);
          const pondAct = wbgtAct * t;

          const celdaWbgt = tr.querySelector('.tarea-wbgt');
          const celdaPond = tr.querySelector('.tarea-pond');

          if (celdaWbgt) celdaWbgt.textContent = wbgtAct.toFixed(2);
          if (celdaPond) celdaPond.textContent = pondAct.toFixed(2);

          if (t > 0) {
            sumaPond += pondAct;
            sumaTiempo += t;
          }
        });

        const elProm = document.getElementById('resWbgtProm');
        const elPond = document.getElementById('resSumaPond');
        const elEff = document.getElementById('resWbgtEff');
        const elCat = document.getElementById('resCatMet');
        const elLim = document.getElementById('resLimRef');
        const elDiag = document.getElementById('resDiagnostico');

        const infoMet = clasificarMetabolismo(metVal);
        elCat.textContent = `Metabolismo: ${infoMet.cat}`;

        if (sumaTiempo > 0) {
          const wbgtProm = sumaPond / sumaTiempo;
          const wbgtEff = wbgtProm + cafVal;
          const limite = limitesPermisibles[cicloIdx][infoMet.idx];

          elProm.textContent = `${wbgtProm.toFixed(2)} °C`;
          elPond.textContent =
            `Σ(WBGTᵢ·tᵢ): ${sumaPond.toFixed(2)} · Σtᵢ: ${sumaTiempo.toFixed(2)}`;
          elEff.textContent = `${wbgtEff.toFixed(2)} °C`;

          if (limite !== null && limite !== undefined) {
            elLim.textContent = `${limite.toFixed(1)} °C`;
            if (wbgtEff > limite) {
              elDiag.textContent =
                'Estado: Supera referencia (requiere controles)';
              elDiag.style.color = '#991b1b';
            } else {
              elDiag.textContent =
                'Estado: Dentro de referencia para el régimen';
              elDiag.style.color = '#155724';
            }
          } else {
            elLim.textContent = 'Sin límite directo';
            elDiag.textContent =
              'Estado: Revisar régimen / evaluación específica';
            elDiag.style.color = '#9c7610';
          }
        } else {
          elProm.textContent = '-- °C';
          elPond.textContent =
            'Ingresa al menos una actividad con tiempo > 0';
          elEff.textContent = '-- °C';
          elLim.textContent = '-- °C';
          elDiag.textContent = 'Estado: --';
        }
      }

      const btnAdd = document.getElementById('btnAgregarTarea');
      const btnCalc = document.getElementById('btnCalcularEstres');
      const container = document.getElementById('calc-estres-termico-p2');

      if (btnAdd) btnAdd.addEventListener('click', agregarFilaTarea);
      if (btnCalc) btnCalc.addEventListener('click', calcularTodo);
      if (container) container.addEventListener('input', calcularTodo);
      if (container) container.addEventListener('change', calcularTodo);

      vincularBotonesEliminar();
      calcularTodo();
    })();
  </script>
</p>

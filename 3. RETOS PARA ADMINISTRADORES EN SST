  <!-- INSTRUCCIONES -->
  <div
    style="background: #ffffff; padding: 22px 26px; border-left: 5px solid #c9a227; border-right: 1px solid #e6dec8; border-bottom: 1px solid #e6dec8; margin: 0; box-shadow: 0 3px 10px rgba(0, 0, 0, 0.05);">

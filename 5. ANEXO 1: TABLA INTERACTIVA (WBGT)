      <div><label
          style="font-weight: 600; color: #1a2a44; display: block; margin-bottom: 6px;">🔄
          Ciclo Trabajo/Descanso</label><select id="cicloTrabajo"
          style="width: 100%; padding: 10px 14px; border: 2px solid #d0dbe8; border-radius: 12px; font-size: 1rem; background: #f8faff; font-weight: 500; cursor: pointer;">
          <option value="0">Trabajo Continuo</option>
          <option value="1">75% Trabajo, 25% Descanso</option>
          <option selected="selected" value="2">50% Trabajo, 50% Descanso
          </option>
          <option value="3">25% Trabajo, 75% Descanso</option>
        </select></div>
      <div><label
          style="font-weight: 600; color: #1a2a44; display: block; margin-bottom: 6px;">📋
          Tipo de Límite</label><select id="tipoLimite"
          style="width: 100%; padding: 10px 14px; border: 2px solid #d0dbe8; border-radius: 12px; font-size: 1rem; background: #f8faff; font-weight: 500; cursor: pointer;">
          <option selected="selected" value="PERMISIBLE">Límite Permisible
          </option>
          <option value="ACCION">Límite de Acción</option>
        </select></div>
      <div
        style="background: #0a2a44; color: white; padding: 14px 20px; border-radius: 16px; text-align: center; min-width: 120px;">
        <div style="font-size: 0.8rem; opacity: 0.7;">WBGT Límite</div>
        <div id="wbgtDisplay"
          style="font-size: 2.4rem; font-weight: 800; line-height: 1;">--</div>
        <div style="font-size: 0.8rem;">°C</div>
        <div id="estadoDisplay"
          style="background: #2ecc71; color: white; padding: 2px 12px; border-radius: 40px; font-weight: bold; font-size: 0.75rem; margin-top: 4px;">
          ✅ SEGURO</div>
      </div>
    </div>
    <div
      style="margin-top: 12px; background: #eef4fc; padding: 10px 16px; border-radius: 12px; font-size: 0.9rem;">
      💡 <strong>Interpretación:</strong> El WBGT es la temperatura media
      ponderada de bulbo húmedo y seco. Superar el límite implica implementar
      medidas de control.</div>
  </div>
  <!-- ======== TABLA WBGT ======== -->
  <div
    style="background: white; border-radius: 16px; padding: 16px; box-shadow: 0 2px 12px rgba(0,0,0,0.06); overflow-x: auto;">
    <h3
      style="color: #0a2a44; margin-top: 0; display: flex; align-items: center; gap: 10px;">
      📊 Tabla de Límites WBGT (°C)</h3>
    <table id="tablaWBGT"
      style="width: 100%; border-collapse: collapse; font-size: 0.9rem; min-width: 700px;">
      <thead>
        <tr style="background: #0a2a44; color: white;">
          <th style="padding: 10px 8px; text-align: center; min-width: 140px;">
            Ciclo de Trabajo</th>
          <th
            style="padding: 10px 8px; text-align: center; background: #1a3a5a;"
            colspan="4">LÍMITE PERMISIBLE</th>
          <th
            style="padding: 10px 8px; text-align: center; background: #c0392b;"
            colspan="4">LÍMITE DE ACCIÓN</th>
        </tr>
        <tr style="background: #1a3a5a; color: white;">
          <th
            style="padding: 8px 4px; text-align: center; font-weight: 400; background: #0a2a44;">
             </th>
          <th style="padding: 8px 4px; text-align: center; font-weight: 400;">
            LIVIANO</th>
          <th style="padding: 8px 4px; text-align: center; font-weight: 400;">
            MODERADO</th>
          <th style="padding: 8px 4px; text-align: center; font-weight: 400;">
            PESADO</th>
          <th style="padding: 8px 4px; text-align: center; font-weight: 400;">
            MUY PESADO</th>
          <th
            style="padding: 8px 4px; text-align: center; font-weight: 400; background: #a93226;">
            LIVIANO</th>
          <th
            style="padding: 8px 4px; text-align: center; font-weight: 400; background: #a93226;">
            MODERADO</th>
          <th
            style="padding: 8px 4px; text-align: center; font-weight: 400; background: #a93226;">
            PESADO</th>
          <th
            style="padding: 8px 4px; text-align: center; font-weight: 400; background: #a93226;">
            MUY PESADO</th>
        </tr>
      </thead>
      <tbody id="tablaWBGTBody"><!-- Se genera con JS --></tbody>
    </table>
    <div
      style="margin-top: 14px; display: flex; gap: 16px; flex-wrap: wrap; font-size: 0.8rem; justify-content: center;">
      <span
        style="background: #2ecc71; padding: 2px 12px; border-radius: 4px; color: white; font-weight: bold;">SEGURO</span>
      WBGT ≤ Límite <span
        style="background: #f1c40f; padding: 2px 12px; border-radius: 4px; color: #0a2a44; font-weight: bold;">ALERTA</span>
      WBGT entre Límite Permisible y Límite de Acción <span
        style="background: #e74c3c; padding: 2px 12px; border-radius: 4px; color: white; font-weight: bold;">PELIGRO</span>
      WBGT ≥ Límite de Acción <span
        style="background: #ff6b6b; padding: 2px 12px; border-radius: 4px; color: white; outline: 2px solid #c0392b;">Destacado</span>
      Celda seleccionada</div>
  </div>
  <!-- ======== ESCALA DE RIESGO ======== -->
  <div
    style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px; margin-top: 24px;">
    <div
      style="background: #d4edda; border-radius: 12px; padding: 14px 18px; border-left: 5px solid #28a745;">
      <div style="font-weight: bold; color: #155724;">✅ ZONA SEGURA</div>
      <div style="font-size: 0.9rem; color: #155724;">WBGT por debajo del Límite
        de Acción. No se requieren medidas especiales.</div>
    </div>
    <div
      style="background: #fff3cd; border-radius: 12px; padding: 14px 18px; border-left: 5px solid #f1c40f;">
      <div style="font-weight: bold; color: #856404;">🟡 ZONA DE ALERTA</div>
      <div style="font-size: 0.9rem; color: #856404;">WBGT entre Límite
        Permisible y Límite de Acción. Implementar monitoreo y medidas
        administrativas.</div>
    </div>
    <div
      style="background: #f8d7da; border-radius: 12px; padding: 14px 18px; border-left: 5px solid #dc3545;">
      <div style="font-weight: bold; color: #721c24;">🔴 ZONA DE PELIGRO</div>
      <div style="font-size: 0.9rem; color: #721c24;">WBGT supera el Límite de
        Acción. Requiere intervención inmediata (descansos, hidratación,
        ingeniería).</div>
    </div>
  </div>
  <div
    style="margin-top: 20px; padding: 12px 20px; background: #e8f0fe; border-radius: 30px; text-align: center; font-size: 0.95rem; color: #1a3a5a;">
    ⬅️ Tabla interactiva — Ajusta los parámetros y observa cómo cambian los
    límites de exposición.</div>
</div>
<p>
  <script>
    // ======== DATOS WBGT ========
    // Estructura: [ciclo][tipoLimite][nivelActividad]
    // Ciclos: 0=Continuo, 1=75/25, 2=50/50, 3=25/75
    // Tipo: 0=Permisible, 1=Acción
    // Niveles: 0=LIVIANO, 1=MODERADO, 2=PESADO, 3=MUY PESADO

    const datosWBGT = [
      // Ciclo Continuo
      [
        // Permisible
        [31.0, 28.0, null, null],
        // Acción
        [28.0, 25.0, null, null]
      ],
      // Ciclo 75/25
      [
        // Permisible
        [31.0, 29.0, 27.5, null],
        // Acción
        [28.0, 26.0, 24.0, null]
      ],
      // Ciclo 50/50
      [
        // Permisible
        [32.0, 30.0, 29.0, 28.0],
        // Acción
        [29.5, 27.0, 25.5, 24.5]
      ],
      // Ciclo 25/75
      [
        // Permisible
        [32.5, 31.5, 30.5, 30.0],
        // Acción
        [30.0, 29.0, 28.0, 27.0]
      ]
    ];

    const nombresCiclos = ['Trabajo Continuo', '75% Trabajo, 25% Descanso',
      '50% Trabajo, 50% Descanso', '25% Trabajo, 75% Descanso'
    ];
    const nombresNiveles = ['LIVIANO', 'MODERADO', 'PESADO', 'MUY PESADO'];
    const nombresTipo = ['PERMISIBLE', 'ACCIÓN'];

    // ======== FUNCIÓN PARA OBTENER VALOR ========
    function obtenerWBGT(ciclo, tipo, nivel) {
      if (ciclo < 0 || ciclo > 3 || tipo < 0 || tipo > 1 || nivel < 0 || nivel >
        3) return null;
      const valor = datosWBGT[ciclo][tipo][nivel];
      return valor !== null && valor !== undefined ? valor : null;
    }

    // ======== RENDERIZAR TABLA ========
    function renderizarTablaWBGT(cicloSeleccionado = 2, tipoSeleccionado = 0,
      nivelSeleccionado = 1) {
      const tbody = document.getElementById('tablaWBGTBody');
      tbody.innerHTML = '';

      for (let i = 0; i < datosWBGT.length; i++) {
        const tr = document.createElement('tr');
        // Columna de ciclo
        const tdCiclo = document.createElement('td');
        tdCiclo.textContent = nombresCiclos[i];
        tdCiclo.style.cssText =
          'padding:10px 8px; border:1px solid #dbe3ef; text-align:left; font-weight:600; background:#eef4fc;';
        tr.appendChild(tdCiclo);

        // Permisible (4 columnas)
        for (let j = 0; j < 4; j++) {
          const td = document.createElement('td');
          const valor = datosWBGT[i][0][j];
          td.textContent = valor !== null ? valor.toFixed(1) : '—';
          td.style.cssText =
            'padding:8px 6px; border:1px solid #dbe3ef; text-align:center; font-weight:500;';

          // Destacar celda seleccionada (Permisible)
          if (i === cicloSeleccionado && tipoSeleccionado === 0 && j ===
            nivelSeleccionado) {
            td.style.cssText +=
              'background:#ff6b6b !important; color:white !important; font-weight:800; outline:3px solid #c0392b;';
          }
          tr.appendChild(td);
        }

        // Acción (4 columnas)
        for (let j = 0; j < 4; j++) {
          const td = document.createElement('td');
          const valor = datosWBGT[i][1][j];
          td.textContent = valor !== null ? valor.toFixed(1) : '—';
          td.style.cssText =
            'padding:8px 6px; border:1px solid #dbe3ef; text-align:center; font-weight:500; background:#fef9e7;';

          // Destacar celda seleccionada (Acción)
          if (i === cicloSeleccionado && tipoSeleccionado === 1 && j ===
            nivelSeleccionado) {
            td.style.cssText +=
              'background:#ff6b6b !important; color:white !important; font-weight:800; outline:3px solid #c0392b;';
          }
          tr.appendChild(td);
        }

        tbody.appendChild(tr);
      }
    }

    // ======== ACTUALIZAR SIMULADOR ========
    function actualizarWBGT() {
      const ciclo = parseInt(document.getElementById('cicloTrabajo').value);
      const tipo = document.getElementById('tipoLimite').value ===
        'PERMISIBLE' ? 0 : 1;
      const nivelMap = {
        'LIVIANO': 0,
        'MODERADO': 1,
        'PESADO': 2,
        'MUY PESADO': 3
      };
      const nivel = nivelMap[document.getElementById('nivelActividad').value];
      const nivelTexto = document.getElementById('nivelActividad').value;

      // Obtener valor WBGT
      const wbgt = obtenerWBGT(ciclo, tipo, nivel);
      const display = document.getElementById('wbgtDisplay');
      const estado = document.getElementById('estadoDisplay');

      if (wbgt !== null) {
        display.textContent = wbgt.toFixed(1);

        // Obtener el valor del otro tipo para comparación
        const otroTipo = tipo === 0 ? 1 : 0;
        const wbgtOtro = obtenerWBGT(ciclo, otroTipo, nivel);

        // Determinar estado de riesgo
        let color, texto;
        if (tipo === 0) {
          // Límite Permisible seleccionado
          if (wbgtOtro !== null && wbgt <= wbgtOtro) {
            color = '#2ecc71';
            texto = '✅ SEGURO';
          } else {
            color = '#f1c40f';
            texto = '🟡 ALERTA';
          }
        } else {
          // Límite de Acción seleccionado
          if (wbgt !== null) {
            color = '#e74c3c';
            texto = '🔴 PELIGRO';
          }
        }
        estado.style.background = color;
        estado.textContent = texto;

        // Renderizar tabla con selección
        renderizarTablaWBGT(ciclo, tipo, nivel);
      } else {
        display.textContent = '—';
        estado.style.background = '#95a5a6';
        estado.textContent = '⚠️ N/A';
      }
    }

    // ======== EVENT LISTENERS ========
    document.getElementById('nivelActividad').addEventListener('change',
      actualizarWBGT);
    document.getElementById('cicloTrabajo').addEventListener('change',
      actualizarWBGT);
    document.getElementById('tipoLimite').addEventListener('change',
      actualizarWBGT);

    // ======== INICIALIZAR ========
    renderizarTablaWBGT(2, 0, 1);
    actualizarWBGT();
  </script>
</p>

  <!-- ======== SIMULADOR ======== -->
  <div
    style="background: white; border-radius: 16px; padding: 22px 26px; margin-bottom: 24px; box-shadow: 0 2px 12px rgba(0,0,0,0.06);">
    <h3
      style="color: #0a2a44; margin-top: 0; display: flex; align-items: center; gap: 10px;">

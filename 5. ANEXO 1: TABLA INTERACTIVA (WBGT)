<div
  style="font-family: 'Segoe UI', Tahoma, sans-serif; max-width: 1100px; margin: auto; padding: 20px; background: #f8fbff; border-radius: 20px; box-shadow: 0 4px 20px rgba(0,0,0,0.08);">

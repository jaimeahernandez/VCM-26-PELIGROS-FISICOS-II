    <div
      style="display: grid; grid-template-columns: 1fr 1fr 1fr auto; gap: 16px; align-items: end; flex-wrap: wrap;">
      <div><label
          style="font-weight: 600; color: #1a2a44; display: block; margin-bottom: 6px;">🏋️
          Nivel de Actividad</label><select id="nivelActividad"
          style="width: 100%; padding: 10px 14px; border: 2px solid #d0dbe8; border-radius: 12px; font-size: 1rem; background: #f8faff; font-weight: 500; cursor: pointer;">
          <option value="LIVIANO">LIVIANO</option>
          <option selected="selected" value="MODERADO">MODERADO</option>

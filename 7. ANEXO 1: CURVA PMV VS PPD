<p>
  <script>
    // ======== FUNCIÓN PPD (ISO 7730) ========
    function calcularPPD(pmv) {
      const pmv2 = pmv * pmv;
      const pmv4 = pmv2 * pmv2;
      const ppd = 100 - 95 * Math.exp(-0.03353 * pmv4 - 0.2179 * pmv2);
      return Math.min(100, Math.max(5, ppd));
    }

    // ======== FUNCIONES DE ESCALA PARA CANVAS ========
    // Canvas: 800x480, margen 60 izq, 40 der, 40 sup, 50 inf
    const MARGEN_IZQ = 60;
    const MARGEN_DER = 40;
    const MARGEN_SUP = 40;
    const MARGEN_INF = 50;
    const ANCHO_GRAF = 800 - MARGEN_IZQ - MARGEN_DER; // 700
    const ALTO_GRAF = 480 - MARGEN_SUP - MARGEN_INF; // 390

    function pmvToX(pmv) {
      // PMV: -2.0 a +2.0 → x: MARGEN_IZQ a MARGEN_IZQ + ANCHO_GRAF
      return MARGEN_IZQ + ((pmv + 2.0) / 4.0) * ANCHO_GRAF;
    }

    function ppdToY(ppd) {
      // PPD: 5% a 80% → y: MARGEN_SUP + ALTO_GRAF a MARGEN_SUP (invertido)
      const pct = Math.min(80, Math.max(5, ppd));
      return MARGEN_SUP + ALTO_GRAF - ((pct - 0) / 80) * ALTO_GRAF;
    }

    // ======== DIBUJAR GRÁFICA EN CANVAS ========
    function dibujarGrafica() {
      const canvas = document.getElementById('graficaCanvas');
      const ctx = canvas.getContext('2d');
      const w = canvas.width;
      const h = canvas.height;

      // Limpiar
      ctx.clearRect(0, 0, w, h);

      // ---- FONDO ----
      ctx.fillStyle = '#fafcff';
      ctx.fillRect(0, 0, w, h);

      // ---- ZONA DE CONFORT (PPD < 10%) ----
      // Calcular coordenadas para PMV -0.5 a +0.5
      const xConfIzq = pmvToX(-0.5);
      const xConfDer = pmvToX(0.5);
      const yPPD10 = ppdToY(10);

      ctx.fillStyle = 'rgba(212, 237, 218, 0.4)';
      ctx.fillRect(xConfIzq, MARGEN_SUP, xConfDer - xConfIzq, yPPD10 -
        MARGEN_SUP);
      ctx.strokeStyle = '#28a745';
      ctx.lineWidth = 2;
      ctx.setLineDash([8, 4]);
      ctx.strokeRect(xConfIzq, MARGEN_SUP, xConfDer - xConfIzq, yPPD10 -
        MARGEN_SUP);
      ctx.setLineDash([]);

      // ---- ETIQUETA ZONA DE CONFORT ----
      ctx.fillStyle = '#1a7a34';
      ctx.font = 'bold 14px Segoe UI, sans-serif';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'top';
      const centroX = (xConfIzq + xConfDer) / 2;
      ctx.fillText('✅ ZONA DE CONFORT', centroX, MARGEN_SUP + 8);
      ctx.font = '12px Segoe UI, sans-serif';
      ctx.fillText('PPD < 10%', centroX, MARGEN_SUP + 30);
      ctx.fillText('PMV entre -0.5 y +0.5', centroX, MARGEN_SUP + 48);

      // ---- CUADRÍCULA Y EJES ----
      // Líneas horizontales (PPD)
      const ppdValores = [0, 10, 30, 60, 80];
      const ppdColores = ['#dbe3ef', '#28a745', '#dbe3ef', '#dbe3ef',
      '#dbe3ef'];
      const ppdGrosor = [1, 3, 1, 1, 1];
      ppdValores.forEach((val, idx) => {
        const y = ppdToY(val);
        ctx.strokeStyle = ppdColores[idx];
        ctx.lineWidth = ppdGrosor[idx];
        if (val === 10) {
          ctx.setLineDash([8, 6]);
        } else {
          ctx.setLineDash([4, 4]);
        }
        ctx.beginPath();
        ctx.moveTo(MARGEN_IZQ, y);
        ctx.lineTo(w - MARGEN_DER, y);
        ctx.stroke();
        ctx.setLineDash([]);

        // Etiquetas
        ctx.fillStyle = (val === 10) ? '#28a745' : '#666';
        ctx.font = (val === 10) ? 'bold 12px Segoe UI, sans-serif' :
          '11px Segoe UI, sans-serif';
        ctx.textAlign = 'end';
        ctx.textBaseline = 'middle';
        ctx.fillText(val + '%', MARGEN_IZQ - 8, y);
      });

      // Líneas verticales (PMV)
      const pmvValores = [-2.0, -1.0, 0, 1.0, 2.0];
      pmvValores.forEach(val => {
        const x = pmvToX(val);
        ctx.strokeStyle = '#dbe3ef';
        ctx.lineWidth = 1;
        ctx.setLineDash([4, 4]);
        ctx.beginPath();
        ctx.moveTo(x, MARGEN_SUP);
        ctx.lineTo(x, h - MARGEN_INF);
        ctx.stroke();
        ctx.setLineDash([]);

        ctx.fillStyle = '#666';
        ctx.font = '11px Segoe UI, sans-serif';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'top';
        ctx.fillText(val.toFixed(1), x, h - MARGEN_INF + 6);
      });

      // ---- LÍMITES PMV -0.5 y +0.5 ----
      [-0.5, 0.5].forEach(val => {
        const x = pmvToX(val);
        ctx.strokeStyle = '#28a745';
        ctx.lineWidth = 2;
        ctx.setLineDash([6, 4]);
        ctx.beginPath();
        ctx.moveTo(x, MARGEN_SUP);
        ctx.lineTo(x, h - MARGEN_INF);
        ctx.stroke();
        ctx.setLineDash([]);
        ctx.fillStyle = '#28a745';
        ctx.font = 'bold 11px Segoe UI, sans-serif';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'bottom';
        ctx.fillText(val.toFixed(1), x, MARGEN_SUP - 4);
      });

      // ---- EJES PRINCIPALES ----
      ctx.strokeStyle = '#0a2a44';
      ctx.lineWidth = 2;
      ctx.setLineDash([]);
      // Eje Y
      ctx.beginPath();
      ctx.moveTo(MARGEN_IZQ, MARGEN_SUP);
      ctx.lineTo(MARGEN_IZQ, h - MARGEN_INF);
      ctx.stroke();
      // Eje X
      ctx.beginPath();
      ctx.moveTo(MARGEN_IZQ, h - MARGEN_INF);
      ctx.lineTo(w - MARGEN_DER, h - MARGEN_INF);
      ctx.stroke();

      // ---- TÍTULOS DE EJES ----
      ctx.fillStyle = '#0a2a44';
      ctx.font = 'bold 14px Segoe UI, sans-serif';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      // Título Y (rotado)
      ctx.save();
      ctx.translate(18, (MARGEN_SUP + h - MARGEN_INF) / 2);
      ctx.rotate(-Math.PI / 2);
      ctx.fillText('PPD (%)', 0, 0);
      ctx.restore();
      // Título X
      ctx.fillText('PMV (Índice de Voto Medio Predicho)', (MARGEN_IZQ + w -
        MARGEN_DER) / 2, h - 8);

      // ---- CURVA PPD ----
      ctx.strokeStyle = '#2e86c1';
      ctx.lineWidth = 3;
      ctx.beginPath();
      let primero = true;
      for (let pmv = -2.0; pmv <= 2.0; pmv += 0.02) {
        const ppd = calcularPPD(pmv);
        const x = pmvToX(pmv);
        const y = ppdToY(ppd);
        if (primero) {
          ctx.moveTo(x, y);
          primero = false;
        } else {
          ctx.lineTo(x, y);
        }
      }
      ctx.stroke();

      // ---- PUNTO ACTUAL ----
      const pmvActual = parseFloat(document.getElementById('pmvInput').value);
      const ppdActual = calcularPPD(pmvActual);
      const xAct = pmvToX(pmvActual);
      const yAct = ppdToY(ppdActual);

      // Líneas de guía
      ctx.strokeStyle = 'rgba(231, 76, 60, 0.5)';
      ctx.lineWidth = 1.5;
      ctx.setLineDash([4, 4]);
      ctx.beginPath();
      ctx.moveTo(xAct, yAct);
      ctx.lineTo(xAct, h - MARGEN_INF);
      ctx.stroke();
      ctx.beginPath();
      ctx.moveTo(MARGEN_IZQ, yAct);
      ctx.lineTo(xAct, yAct);
      ctx.stroke();
      ctx.setLineDash([]);

      // Etiquetas del punto
      ctx.fillStyle = '#e74c3c';
      ctx.font = 'bold 12px Segoe UI, sans-serif';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'top';
      ctx.fillText('PMV: ' + pmvActual.toFixed(2), xAct, h - MARGEN_INF + 22);
      ctx.textAlign = 'end';
      ctx.textBaseline = 'middle';
      ctx.fillText('PPD: ' + ppdActual.toFixed(1) + '%', MARGEN_IZQ - 10, yAct);

      // Punto (círculo)
      ctx.shadowColor = 'rgba(0,0,0,0.2)';
      ctx.shadowBlur = 8;
      ctx.beginPath();
      ctx.arc(xAct, yAct, 8, 0, 2 * Math.PI);
      ctx.fillStyle = '#e74c3c';
      ctx.fill();
      ctx.shadowBlur = 0;
      ctx.strokeStyle = 'white';
      ctx.lineWidth = 2.5;
      ctx.stroke();

      // Círculo exterior
      ctx.beginPath();
      ctx.arc(xAct, yAct, 13, 0, 2 * Math.PI);
      ctx.strokeStyle = 'rgba(231, 76, 60, 0.3)';
      ctx.lineWidth = 2;
      ctx.stroke();
    }

    // ======== ACTUALIZAR TODO ========
    function actualizarTodo() {
      const pmv = parseFloat(document.getElementById('pmvInput').value);
      const ppd = calcularPPD(pmv);

      // Actualizar displays
      document.getElementById('ppdDisplay').textContent = ppd.toFixed(1);
      document.getElementById('pmvSlider').value = pmv;

      // Estado de confort
      const confortDisplay = document.getElementById('confortDisplay');
      if (pmv >= -0.5 && pmv <= 0.5) {
        confortDisplay.style.background = '#2ecc71';
        confortDisplay.textContent = '✅ CONFORTABLE';
      } else if (pmv >= -1.0 && pmv <= 1.0) {
        confortDisplay.style.background = '#f1c40f';
        confortDisplay.textContent = '🟡 LÍMITE ACEPTABLE';
      } else if (pmv >= -1.5 && pmv <= 1.5) {
        confortDisplay.style.background = '#e67e22';
        confortDisplay.textContent = '🟠 ALTA INSATISFACCIÓN';
      } else {
        confortDisplay.style.background = '#e74c3c';
        confortDisplay.textContent = '🔴 INSATISFACCIÓN EXTREMA';
      }

      // Resaltar fila en tabla
      resaltarFilaTabla(pmv);

      // Dibujar gráfica
      dibujarGrafica();
    }

    // ======== RESALTAR FILA ========
    function resaltarFilaTabla(pmv) {
      const filas = ['fila0', 'fila05', 'fila1', 'fila15', 'fila2'];
      const valores = [0, 0.5, 1.0, 1.5, 2.0];
      const absPmv = Math.abs(pmv);

      filas.forEach(id => {
        const fila = document.getElementById(id);
        if (fila) {
          fila.style.background = '';
          fila.style.fontWeight = '';
        }
      });

      let minDiff = Infinity;
      let closestId = null;
      filas.forEach((id, index) => {
        const diff = Math.abs(absPmv - valores[index]);
        if (diff < minDiff) {
          minDiff = diff;
          closestId = id;
        }
      });

      if (closestId && minDiff < 0.1) {
        const fila = document.getElementById(closestId);
        if (fila) {
          fila.style.background = '#d4edda';
          fila.style.fontWeight = '700';
        }
      }
    }

    // ======== EVENT LISTENERS ========
    document.getElementById('pmvSlider').addEventListener('input', function() {
      const val = parseFloat(this.value);
      document.getElementById('pmvInput').value = val.toFixed(2);
      actualizarTodo();
    });

    document.getElementById('pmvInput').addEventListener('input', function() {
      let val = parseFloat(this.value);
      if (isNaN(val)) val = 0;
      val = Math.max(-2.0, Math.min(2.0, val));
      document.getElementById('pmvSlider').value = val;
      actualizarTodo();
    });

    // ======== REDIBUJAR AL CAMBIAR TAMAÑO ========
    window.addEventListener('resize', function() {
      // El canvas se redimensiona automáticamente con CSS
      dibujarGrafica();
    });

    // ======== INICIALIZAR ========
    actualizarTodo();
  </script>

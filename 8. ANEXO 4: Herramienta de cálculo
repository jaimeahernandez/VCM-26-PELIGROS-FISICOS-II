  <script>
    // ============================================================
    // FUNCIÓN PRINCIPAL DE CÁLCULO
    // ============================================================
    function calcularTodo() {
      try {
        // Leer valores SECCIÓN 1
        var e1_265 = parseFloat(document.getElementById('e1_265').value) || 0;
        var e1_270 = parseFloat(document.getElementById('e1_270').value) || 0;
        var e1_275 = parseFloat(document.getElementById('e1_275').value) || 0;
        var e1_280 = parseFloat(document.getElementById('e1_280').value) || 0;

        // Leer valores SECCIÓN 2
        var e2_265 = parseFloat(document.getElementById('e2_265').value) || 0;
        var e2_270 = parseFloat(document.getElementById('e2_270').value) || 0;
        var e2_275 = parseFloat(document.getElementById('e2_275').value) || 0;
        var e2_280 = parseFloat(document.getElementById('e2_280').value) || 0;

        // Factores de ponderación
        var S265 = 0.50,
          S270 = 0.85,
          S275 = 0.95,
          S280 = 0.88;
        var delta = 5;

        // --- SECCIÓN 1: IRRADIANCIA TOTAL ---
        var prod1_265 = e1_265 * delta;
        var prod1_270 = e1_270 * delta;
        var prod1_275 = e1_275 * delta;
        var prod1_280 = e1_280 * delta;
        var totalE = prod1_265 + prod1_270 + prod1_275 + prod1_280;

        // Actualizar celdas
        document.getElementById('prod1_265').innerHTML = prod1_265.toFixed(4);
        document.getElementById('prod1_270').innerHTML = prod1_270.toFixed(4);
        document.getElementById('prod1_275').innerHTML = prod1_275.toFixed(4);
        document.getElementById('prod1_280').innerHTML = prod1_280.toFixed(4);
        document.getElementById('totalE').innerHTML = totalE.toFixed(4);
        document.getElementById('resultE').innerHTML = totalE.toFixed(4);

        // --- SECCIÓN 2: IRRADIANCIA EFECTIVA ---
        var prod2_265 = e2_265 * S265 * delta;
        var prod2_270 = e2_270 * S270 * delta;
        var prod2_275 = e2_275 * S275 * delta;
        var prod2_280 = e2_280 * S280 * delta;
        var totalEff = prod2_265 + prod2_270 + prod2_275 + prod2_280;

        document.getElementById('prod2_265').innerHTML = prod2_265.toFixed(4);
        document.getElementById('prod2_270').innerHTML = prod2_270.toFixed(4);
        document.getElementById('prod2_275').innerHTML = prod2_275.toFixed(4);
        document.getElementById('prod2_280').innerHTML = prod2_280.toFixed(4);
        document.getElementById('totalEff').innerHTML = totalEff.toFixed(4);
        document.getElementById('resultEff').innerHTML = totalEff.toFixed(4);

        // --- SECCIÓN 3: EXPOSICIÓN E ÍNDICE DE RIESGO ---
        var tiempo = parseFloat(document.getElementById('tiempo').value) || 0;
        var heff = totalEff * tiempo;
        var VLE = 30;
        var ir = heff / VLE;

        document.getElementById('heff').innerHTML = heff.toFixed(4);
        document.getElementById('ir').innerHTML = ir.toFixed(4);

        // Cambiar estado según riesgo
        var estado = document.getElementById('estado');
        var mensaje = document.getElementById('mensaje');

        if (ir > 1.0) {
          estado.style.background = '#fce1e1';
          estado.style.color = '#a12727';
          estado.style.border = '1px solid #dba6a6';
          estado.innerHTML = '⚠️ Supera VLE-1';
          mensaje.innerHTML =
            '🔴 <strong>"Supera el VLE-1"</strong> · Riesgo alto. Se deben tomar medidas de control.';
        } else {
          estado.style.background = '#dff0d8';
          estado.style.color = '#1f6b3b';
          estado.style.border = '1px solid #b3d6b3';
          estado.innerHTML = '✅ Cumple VLE-1';
          mensaje.innerHTML = '🟢 Condición segura · IR ≤ 1.0';
        }

        return true;
      } catch (e) {
        return false;
      }
    }

    // ============================================================
    // FUNCIONES DE CONTROL
    // ============================================================
    function resetearTodo() {
      document.getElementById('e1_265').value = '0';
      document.getElementById('e1_270').value = '0';
      document.getElementById('e1_275').value = '0';
      document.getElementById('e1_280').value = '0';
      document.getElementById('e2_265').value = '0';
      document.getElementById('e2_270').value = '0';
      document.getElementById('e2_275').value = '0';
      document.getElementById('e2_280').value = '0';
      document.getElementById('tiempo').value = '1.0';
      calcularTodo();
    }

    function cargarEjemplo() {
      document.getElementById('e1_265').value = '0.5';
      document.getElementById('e1_270').value = '0.8';
      document.getElementById('e1_275').value = '1.2';
      document.getElementById('e1_280').value = '0.6';
      document.getElementById('e2_265').value = '0.5';
      document.getElementById('e2_270').value = '0.8';
      document.getElementById('e2_275').value = '1.2';
      document.getElementById('e2_280').value = '0.6';
      document.getElementById('tiempo').value = '1.0';
      calcularTodo();
    }

    function cargarEjemploRiesgo() {
      document.getElementById('e1_265').value = '3.0';
      document.getElementById('e1_270').value = '4.0';
      document.getElementById('e1_275').value = '5.0';
      document.getElementById('e1_280').value = '3.0';
      document.getElementById('e2_265').value = '3.0';
      document.getElementById('e2_270').value = '4.0';
      document.getElementById('e2_275').value = '5.0';
      document.getElementById('e2_280').value = '3.0';
      document.getElementById('tiempo').value = '2.0';
      calcularTodo();
    }

    // ============================================================
    // ¡¡¡ CLAVE DE LA SOLUCIÓN: TEMPORIZADOR !!!
    // ============================================================
    // Este temporizador revisa los campos cada 500ms y actualiza
    // automáticamente, SIN DEPENDER de eventos bloqueados por Moodle
    // ============================================================

    // Variable para almacenar los valores anteriores
    var valoresAnteriores = {};

    function verificarCambios() {
      try {
        // Lista de campos a monitorear
        var campos = ['e1_265', 'e1_270', 'e1_275', 'e1_280', 'e2_265',
          'e2_270', 'e2_275', 'e2_280', 'tiempo'
        ];
        var hayCambios = false;

        // Verificar si algún campo cambió
        for (var i = 0; i < campos.length; i++) {
          var id = campos[i];
          var elemento = document.getElementById(id);
          if (elemento) {
            var valorActual = elemento.value;
            if (valoresAnteriores[id] !== valorActual) {
              valoresAnteriores[id] = valorActual;
              hayCambios = true;
            }
          }
        }

        // Si hubo cambios, recalcular
        if (hayCambios) {
          calcularTodo();
        }
      } catch (e) {
        // Si hay error, no hacemos nada
      }
    }

    // Iniciar el temporizador (cada 500ms)
    var temporizador = setInterval(verificarCambios, 500);

    // Calcular al cargar
    calcularTodo();

    // Respaldos con eventos (por si acaso funcionan)
    var todosLosInputs = document.querySelectorAll('input[type="number"]');
    for (var i = 0; i < todosLosInputs.length; i++) {
      todosLosInputs[i].addEventListener('input', function() {
        // Forzar actualización inmediata
        calcularTodo();
      });
      todosLosInputs[i].addEventListener('change', function() {
        calcularTodo();
      });
    }

    console.log('✅ Simulador funcionando con temporizador cada 500ms');

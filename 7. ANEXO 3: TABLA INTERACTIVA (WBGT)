<p>
  <script>
    (function() {
      const datosWBGT = [
        [
          [31.0, 28.0, null, null],
          [28.0, 25.0, null, null]
        ],
        [
          [31.0, 29.0, 27.5, null],
          [28.0, 26.0, 24.0, null]
        ],
        [
          [32.0, 30.0, 29.0, 28.0],
          [29.5, 27.0, 25.5, 24.5]
        ],
        [
          [32.5, 31.5, 30.5, 30.0],
          [30.0, 29.0, 28.0, 27.0]
        ]
      ];

      const nombresCiclos = [
        'Trabajo Continuo',
        '75% Trabajo, 25% Descanso',
        '50% Trabajo, 50% Descanso',
        '25% Trabajo, 75% Descanso'
      ];

      const nivelMap = {
        'LIVIANO': 0,
        'MODERADO': 1,
        'PESADO': 2,
        'MUY PESADO': 3
      };

      function obtenerWBGT(ciclo, tipo, nivel) {
        if (ciclo < 0 || ciclo > 3 || tipo < 0 || tipo > 1 || nivel < 0 ||
          nivel > 3) return null;
        const valor = datosWBGT[ciclo][tipo][nivel];
        return valor !== null && valor !== undefined ? valor : null;
      }

      function renderizarTablaWBGT(cicloSeleccionado, tipoSeleccionado,
        nivelSeleccionado) {
        const tbody = document.getElementById('tablaWBGTBody');
        if (!tbody) return;
        tbody.innerHTML = '';

        for (let i = 0; i < datosWBGT.length; i++) {
          const tr = document.createElement('tr');

          const tdCiclo = document.createElement('td');
          tdCiclo.textContent = nombresCiclos[i];
          tdCiclo.style.cssText =
            'padding:10px 8px; border:1px solid #dbe3ef; text-align:left; font-weight:700; color:#07192f; background:#f6f3ec;';
          tr.appendChild(tdCiclo);

          for (let j = 0; j < 4; j++) {
            const td = document.createElement('td');
            const valor = datosWBGT[i][0][j];
            td.textContent = valor !== null ? valor.toFixed(1) : '—';
            td.style.cssText =
              'padding:8px 6px; border:1px solid #dbe3ef; text-align:center; font-weight:600; color:#1e293b; background:#ffffff;';

            if (i === cicloSeleccionado && tipoSeleccionado === 0 && j ===
              nivelSeleccionado) {
              td.style.cssText +=
                'background:#c9a227 !important; color:#07192f !important; font-weight:800; outline:3px solid #07192f;';
            }
            tr.appendChild(td);
          }

          for (let j = 0; j < 4; j++) {
            const td = document.createElement('td');
            const valor = datosWBGT[i][1][j];
            td.textContent = valor !== null ? valor.toFixed(1) : '—';
            td.style.cssText =
              'padding:8px 6px; border:1px solid #dbe3ef; text-align:center; font-weight:600; color:#1e293b; background:#fffbeb;';

            if (i === cicloSeleccionado && tipoSeleccionado === 1 && j ===
              nivelSeleccionado) {
              td.style.cssText +=
                'background:#c9a227 !important; color:#07192f !important; font-weight:800; outline:3px solid #07192f;';
            }
            tr.appendChild(td);
          }

          tbody.appendChild(tr);
        }
      }

      function actualizarWBGT() {
        const selCiclo = document.getElementById('cicloTrabajo');
        const selTipo = document.getElementById('tipoLimite');
        const selNivel = document.getElementById('nivelActividad');
        const display = document.getElementById('wbgtDisplay');
        const estado = document.getElementById('estadoDisplay');
        if (!selCiclo || !selTipo || !selNivel || !display || !estado) return;

        const ciclo = parseInt(selCiclo.value, 10);
        const tipo = selTipo.value === 'PERMISIBLE' ? 0 : 1;
        const nivel = nivelMap[selNivel.value];

        const wbgt = obtenerWBGT(ciclo, tipo, nivel);

        if (wbgt !== null) {
          display.textContent = wbgt.toFixed(1);
          const otroTipo = tipo === 0 ? 1 : 0;
          const wbgtOtro = obtenerWBGT(ciclo, otroTipo, nivel);

          let color, textoColor, texto;
          if (tipo === 0) {
            if (wbgtOtro !== null && wbgt <= wbgtOtro) {
              color = '#2ecc71';
              textoColor = '#ffffff';
              texto = '✅ SEGURO';
            } else {
              color = '#f1c40f';
              textoColor = '#07192f';
              texto = '🟡 ALERTA';
            }
          } else {
            color = '#e74c3c';
            textoColor = '#ffffff';
            texto = '🔴 PELIGRO';
          }
          estado.style.background = color;
          estado.style.color = textoColor;
          estado.textContent = texto;
          renderizarTablaWBGT(ciclo, tipo, nivel);
        } else {
          display.textContent = '—';
          estado.style.background = '#95a5a6';
          estado.style.color = '#ffffff';
          estado.textContent = '⚠️ N/A';
          renderizarTablaWBGT(ciclo, tipo, nivel);
        }
      }

      const nivelEl = document.getElementById('nivelActividad');
      const cicloEl = document.getElementById('cicloTrabajo');
      const tipoEl = document.getElementById('tipoLimite');

      if (nivelEl) nivelEl.addEventListener('change', actualizarWBGT);
      if (cicloEl) cicloEl.addEventListener('change', actualizarWBGT);
      if (tipoEl) tipoEl.addEventListener('change', actualizarWBGT);

      actualizarWBGT();
    })();
  </script>
